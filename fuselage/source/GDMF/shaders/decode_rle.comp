#version 450

// Decode one run-length row per invocation.
// SEE: (GDMF_COMPUTE.md, Compute shaders)

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Bytes {
    uint input_words[];
};

layout(std430, binding = 1) readonly buffer Palette {
    uint palette_colors[];
};

layout(binding = 2, rgba8) uniform writeonly image2D output_image;

layout(push_constant) uniform DecodeRlePushConstants {
    uint table_offset;
    uint data_offset;
    uint data_length;
    uint width;
    uint height;
    int  destination_x;
    int  destination_y;
    uint palette_base;
    uint image_width;
    uint image_height;
} decode_push;

uint read_byte(uint byte_offset) {
    return (input_words[byte_offset >> 2] >> ((byte_offset & 3u) * 8u)) & 0xFFu;
}

vec4 unpack_color(uint packed_color) {
    return vec4(float( packed_color        & 0xFFu),
                float((packed_color >>  8) & 0xFFu),
                float((packed_color >> 16) & 0xFFu),
                float((packed_color >> 24) & 0xFFu)) / 255.0;
}

void main() {
    uint row_index = gl_GlobalInvocationID.x;
    if (row_index >= decode_push.height) { return; }

    int target_y = decode_push.destination_y + int(row_index);
    if (target_y < 0 || uint(target_y) >= decode_push.image_height) { return; }

    uint stream_offset   = decode_push.data_offset + input_words[(decode_push.table_offset >> 2) + row_index];
    uint stream_end = decode_push.data_offset + decode_push.data_length;

    uint pixel_x = 0u;
    while (pixel_x < decode_push.width) {
        // Stop incomplete pairs and zero-length runs; earlier stores remain.
        if (stream_offset + 2u > stream_end) { return; }
        uint run_length = read_byte(stream_offset);
        uint palette_index = read_byte(stream_offset + 1u);
        stream_offset += 2u;
        if (run_length == 0u) { return; }

        vec4 color = unpack_color(palette_colors[decode_push.palette_base + palette_index]);
        uint run_end = min(pixel_x + run_length, decode_push.width);
        for (; pixel_x < run_end; pixel_x++) {
            int target_x = decode_push.destination_x + int(pixel_x);
            if (target_x < 0 || uint(target_x) >= decode_push.image_width) { continue; }
            imageStore(output_image, ivec2(target_x, target_y), color);
        }
    }
}
